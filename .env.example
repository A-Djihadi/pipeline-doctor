# Copier en .env (ignore par git). Ne jamais committer de vraies valeurs.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# Notification Slack (session 2) : a stocker comme secret GitHub
# (Settings > Secrets and variables > Actions), pas dans .env.
# SLACK_WEBHOOK_URL=

# Agent auto-heberge (session 3) : variables locales de l'agent.
PD_REPO=A-Djihadi/pipeline-doctor
PD_WORKFLOW=ci.yml
# GITHUB_TOKEN=   (token lecture seule Actions:read, jamais committe)
# PD_DB=diagnostics.db

# Extra agent (ADR-0005) : graphe LangGraph + traces Langfuse auto-heberge.
# Sans ces variables, le graphe tourne sans tracing (no-op).
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=   (jamais committe)
# PD_ENV=local

# v2 — Sources CI (ADR-0007). PD_SOURCES: sous-ensemble de "github,jenkins" (defaut "github").
# PD_SOURCES=github,jenkins

# v2 — Source Jenkins (requis si "jenkins" active).
# PD_JENKINS_URL=https://jenkins.example.com
# PD_JENKINS_JOBS=team/app/main
# PD_JENKINS_USER=   (utilisateur lecture seule, Overall/Read + Job/Read)
# PD_JENKINS_TOKEN=   (token API de cet utilisateur, jamais committe)
# PD_JENKINS_PER_JOB=10
# PD_JENKINS_MAX_LOG_BYTES=2097152

# v2 — Correctifs proposes (ADR-0008). PD_FIX_MODE: off (defaut), propose ou pr.
# Mode "propose" : poste un diff garde sur Slack, aucune ecriture.
# PD_FIX_MODE=propose
# Mode "pr" : ouvre une PR draft depuis un fork bot. Necessite le fork et le token.
# PD_FIX_MODE=pr
# PD_FIX_FORK=pd-bot/pipeline-doctor   (fork du bot, PAS collaborateur de l'upstream)
# PD_FIX_TOKEN=   (classic PAT du bot, scope public_repo uniquement, != GITHUB_TOKEN)
# PD_FIX_MAX_PER_DAY=3
