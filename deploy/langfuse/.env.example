# Langfuse auto-heberge : variables lues par le docker-compose officiel (copier en .env).
# Valeurs de DEV LOCAL uniquement : a regenerer (openssl rand -hex 32) hors poste de dev.

# Initialisation sans clic (headless init) : org, projet, cles API et compte admin crees au 1er demarrage
LANGFUSE_INIT_ORG_ID=pipeline-doctor
LANGFUSE_INIT_ORG_NAME=pipeline-doctor
LANGFUSE_INIT_PROJECT_ID=pipeline-doctor
LANGFUSE_INIT_PROJECT_NAME=pipeline-doctor
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev
LANGFUSE_INIT_USER_EMAIL=admin@pipeline-doctor.test
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me-local-dev

TELEMETRY_ENABLED=false
